{
  "name": "server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node dev.mjs",
    "build": "node ../node_modules/typescript/bin/tsc && node copy-schema.mjs",
    "start": "node --env-file=.env dist/main.js",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "migrate:up": "node --env-file=.env ../node_modules/node-pg-migrate/bin/node-pg-migrate.js up -m migrations --migration-file-language sql",
    "migrate:down": "node --env-file=.env ../node_modules/node-pg-migrate/bin/node-pg-migrate.js down -m migrations --migration-file-language sql",
    "seed": "node --env-file=.env dist/seed.js"
  },
  "dependencies": {
    "graphql": "^16.11.0",
    "graphql-yoga": "^5.16.0",
    "node-pg-migrate": "^7.9.1",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^22.17.0",
    "@types/pg": "^8.15.5",
    "typescript": "~5.9.2",
    "vitest": "^3.2.4"
  }
}
